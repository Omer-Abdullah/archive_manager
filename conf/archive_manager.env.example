# archive_manager.env  -  settings for archive_manager.sh (archive_manager v1.0.0)
# Copy to conf/archive_manager.env, edit, then:  chmod 600 conf/archive_manager.env
# Sourced by bash: keep it KEY=value, no spaces around "=".

# Oracle client
# Leave these commented when the oracle user's profile already sets them
# (typical on the database server). Uncomment and adjust otherwise.
# export ORACLE_HOME=/u01/app/oracle/product/19.0.0/dbhome_1
# export PATH="${ORACLE_HOME}/bin:${PATH}"
# export TNS_ADMIN=/u01/app/archive_manager/tns
# export NLS_LANG=AMERICAN_AMERICA.AL32UTF8

# ---------------------------------------------------------------------------
# Database login - Option A: user / password
# ---------------------------------------------------------------------------
DB_USER="ARCH_OWNER"
# Leave DB_PASSWORD empty to be prompted on the terminal (recommended), or
# export ARCH_DB_PASSWORD before the call. If you do put the password here,
# keep this file chmod 600. A password containing " is not supported.
DB_PASSWORD=""
# TNS alias from tnsnames.ora, or EZConnect //host:1521/service.
# Point it at ONE RAC service (preferred on one instance) so the run stays on
# one node. Empty = the local instance of ORACLE_SID on this server.
DB_TNS="MYDB"

# ---------------------------------------------------------------------------
# Database login - Option B: Oracle wallet (no password anywhere)
# Used only when DB_USER above is empty.
# ---------------------------------------------------------------------------
DB_CONNECT=""
# DB_CONNECT="/@MYDB"

# Schema that owns PKG_ARCHIVE_MANAGER and the control tables (empty = DB_USER)
PKG_OWNER=""

# Log files of the utility (the database keeps its own log in ARCHIVE_LOG)
LOG_DIR="/u01/app/archive_manager/logs"
LOG_RETENTION_DAYS=90

# Optional: command run when an execution ends FAILED or STOPPED, called as
#   $ALERT_CMD <status> <run_id> <exec_id> <log_file> <message>
# e.g. a script that sends mail or posts to a chat channel.
ALERT_CMD=""
